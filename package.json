{
  "name": "@ihyeon/return-review-console",
  "version": "0.2.4",
  "description": "A local return review console with durable approval history",
  "homepage": "https://www.npmjs.com/package/@ihyeon/return-review-console",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hyeonse-swing/return-review-console.git"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "return-review-console": "./bin/return-review-console.mjs"
  },
  "files": [
    "bin/return-review-console.mjs",
    "server/index.mjs",
    "server/storage.mjs",
    "shared/fixtures.json",
    "dist/",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "build:demo": "tsc --noEmit && vite build --mode demo --outDir dist-demo",
    "prepack": "npm run build",
    "start": "node bin/return-review-console.mjs",
    "start:dev": "node server/index.mjs",
    "test": "node --test server/*.test.mjs",
    "test:browser": "node checks/concurrency.mjs && npm run build:demo && node checks/reinspection.mjs && node checks/data-table.mjs",
    "test:package": "node checks/package-consumer.mjs",
    "qa:pr": "node qa/pr-regression.mjs"
  },
  "devDependencies": {
    "@hyeonse/design-system": "https://design-system.hyeonse.dev/releases/hyeonse-design-system-0.5.0.tgz",
    "@ihyeon/browser-error-log": "0.2.18",
    "lucide-react": "1.75.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@ihyeon/error-to-test": "0.4.7",
    "@ihyeon/flow-qa": "0.9.9",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "playwright": "1.63.0",
    "typescript": "5.9.3",
    "vite": "8.3.8"
  }
}
